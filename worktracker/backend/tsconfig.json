{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["server.ts", "src/**/*.ts", "prisma/**/*.ts"]
}
