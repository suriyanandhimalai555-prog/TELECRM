// Prisma Schema definition for Work Tracker Enterprise

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String
  department   String
  state        String?
  employeeId   String?  @unique @map("employee_id")
  mobileNumber String?  @map("mobile_number")
  managerId    String?  @map("manager_id")
  managerName  String?  @map("manager_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Self-referential manager relation
  manager      User?    @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]   @relation("ManagerSubordinates")

  // Relationships
  workUpdates         WorkUpdate[]     @relation("UserWorkUpdates")
  reviewedWorkUpdates WorkUpdate[]     @relation("ReviewerWorkUpdates")
  editHistories       EditHistory[]    @relation("UserEditHistories")
  queries             EmployeeQuery[]  @relation("UserQueries")
  respondedQueries    EmployeeQuery[]  @relation("QueryResponder")
  notifications       Notification[]
  eodRecords          EodRecord[]
  eodEnablements      EodEnablement[] @relation("EodEnablementEmployee")
  eodEnabledByMe      EodEnablement[] @relation("EodEnablementEnabler")

  @@index([email])
  @@index([managerId])
  @@index([department])
  @@map("users")
}

model WorkUpdate {
  id            String    @id
  userId        String    @map("user_id")
  userName      String    @map("user_name")
  userRole      String    @map("user_role")
  userEmail     String    @map("user_email")
  department    String
  title         String
  description   String
  hoursSpent    Float     @default(0.0) @map("hours_spent")
  category      String
  status        String    @default("pending")
  reviewerId    String?   @map("reviewer_id")
  reviewerName  String?   @map("reviewer_name")
  reviewComment String?   @map("review_comment")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relationships
  user        User             @relation("UserWorkUpdates", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?            @relation("ReviewerWorkUpdates", fields: [reviewerId], references: [id], onDelete: SetNull)
  attachments WorkAttachment[]
  editHistory EditHistory[]

  @@index([userId])
  @@index([status])
  @@index([department])
  @@index([category])
  @@index([createdAt])
  @@index([reviewerId])
  @@map("work_updates")
}

model WorkAttachment {
  id         String   @id
  workId     String   @map("work_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileSize   BigInt   @default(0) @map("file_size")
  fileType   String   @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relationships
  work WorkUpdate @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("work_attachments")
}

model EditHistory {
  id           String   @id
  workId       String   @map("work_id")
  editedBy     String   @map("edited_by")
  editedByName String   @map("edited_by_name")
  changes      Json     @default("[]")
  editedAt     DateTime @default(now()) @map("edited_at")

  // Relationships
  work   WorkUpdate @relation(fields: [workId], references: [id], onDelete: Cascade)
  editor User       @relation("UserEditHistories", fields: [editedBy], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("edit_history")
}

model EmployeeQuery {
  id              String    @id
  userId          String    @map("user_id")
  userName        String    @map("user_name")
  userEmail       String    @map("user_email")
  department      String
  queryType       String    @map("query_type")
  subject         String
  description     String
  relatedDate     DateTime? @map("related_date") @db.Date
  status          String    @default("pending")
  hrResponse      String?   @map("hr_response")
  respondedBy     String?   @map("responded_by")
  respondedByName String?   @map("responded_by_name")
  respondedAt     DateTime? @map("responded_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user      User  @relation("UserQueries", fields: [userId], references: [id], onDelete: Cascade)
  responder User? @relation("QueryResponder", fields: [respondedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([queryType])
  @@index([createdAt])
  @@map("employee_queries")
}

model Notification {
  id        String   @id
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  linkTab   String?  @map("link_tab")
  linkId    String?  @map("link_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model EodRecord {
  id        String   @id
  userId    String   @map("user_id")
  date      DateTime @db.Date
  status    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@map("eod_records")
}

/// HR override allowing an employee to submit EOD outside the 9 AM–7 PM window
model EodEnablement {
  id            String   @id
  userId        String   @map("user_id")
  date          DateTime @db.Date
  enabledById   String   @map("enabled_by_id")
  enabledByName String   @map("enabled_by_name")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  user      User @relation("EodEnablementEmployee", fields: [userId], references: [id], onDelete: Cascade)
  enabledBy User @relation("EodEnablementEnabler", fields: [enabledById], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([enabledById])
  @@map("eod_enablements")
}
